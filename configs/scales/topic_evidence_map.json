      "context": "General mood, diagnosis or treatment history. Never sufficient on its own for an item score."
    },
    "strength": {
      "direct": "Asks the symptom itself.",
      "indirect": "Elicits the symptom obliquely; needs the scorer to interpret."
    }
  },
